# Pinned chart versions. Sourced by bootstrap/install.sh and by the GitHub
# Action, so a rebuilt cluster gets byte-identical operators.

# https://github.com/cert-manager/cert-manager/releases
CERT_MANAGER_VERSION=v1.21.1

# https://github.com/strimzi/strimzi-kafka-operator/releases
#
# PINNED DELIBERATELY. Strimzi 1.1.0 released a breaking change: "Remove
# support for Kafka 4.1.x". infrastructure/kafka/kafka-cluster.yaml runs Kafka
# 4.1.0, so 1.0.1 is the newest operator that can manage it.
#
# To move to Strimzi >= 1.1.0 you must first upgrade Kafka to 4.2.x while still
# on 1.0.1, let the rolling update finish, and only then bump the operator.
STRIMZI_VERSION=1.0.1
